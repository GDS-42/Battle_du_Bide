# --- Obligatoire -------------------------------------------------------------
# Base PostgreSQL (le service « db » du docker-compose en production).
DATABASE_URL=postgres://bdb:motdepasse@db:5432/battle_du_bide
# URL publique de l'app (sert aux liens magiques et aux notifications).
APP_URL=https://bide.example.com

# --- E-mails (liens de connexion) ---------------------------------------------
# Laisser vide en dev : le lien magique est affiché à l'écran et dans les logs.
# Format : smtp(s)://utilisateur:motdepasse@serveur:port
SMTP_URL=
MAIL_FROM="Battle du Bide <ring@example.com>"

# --- Notifications push (Web Push / VAPID) --------------------------------------
# Générer une paire : npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ring@example.com

# --- Tâche planifiée -----------------------------------------------------------
# L'app vérifie chaque minute s'il y a un combat à révéler ou un rappel à envoyer.
# Mettre 0 pour désactiver l'horloge interne et appeler /api/cron/tick de l'extérieur.
INTERNAL_CLOCK=1
# Facultatif : secret pour appeler POST /api/cron/tick de l'extérieur (en-tête Authorization: Bearer ...).
# Laissé vide, un secret interne est généré au démarrage.
CRON_SECRET=

# --- Divers --------------------------------------------------------------------
# Dossier des photos de balance (option anti-triche). Monter un volume dessus.
UPLOAD_DIR=/app/uploads
# Fuseau horaire par défaut des battles.
DEFAULT_TIMEZONE=Europe/Paris
# Afficher le lien magique à l'écran même en production (déconseillé).
SHOW_MAGIC_LINK=0
